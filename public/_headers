# Cache rules for Cloudflare (copied into dist/ by the build).

# Vite's files carry a content hash in their name: safe to keep for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, shapes, fonts and icons keep their names: a week, then the browser checks again.
/photo/*
  Cache-Control: public, max-age=604800
/photo-hero/*
  Cache-Control: public, max-age=604800
/shapes/*
  Cache-Control: public, max-age=604800
/font/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800

# Basic hardening for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
